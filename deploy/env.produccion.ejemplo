# Copiar como .env en la carpeta de la aplicación del servidor y completar DB_PASSWORD.
APP_NAME="FICCT Laboratorios"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.tecnoweb.org.bo/inf513/grupo08sa/proyecto2
APP_TIMEZONE=America/La_Paz
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db.tecnoweb.org.bo
DB_PORT=5432
DB_DATABASE=db_grupo08sa
DB_USERNAME=grupo08sa
DB_PASSWORD=CAMBIAR_POR_LA_CONTRASENA
# Esquema PROPIO del proyecto 2 (para no tocar las tablas del proyecto 1 vía mail).
# Crearlo una sola vez:  CREATE SCHEMA proyecto2;
DB_SCHEMA=proyecto2

# Datos iniciales: se importan los datos REALES del proyecto 1 (esquema sislab, solo lectura).
# auto = usa sislab si existe | sislab | demo (datos inventados)
ORIGEN_DATOS=auto
ORIGEN_SISLAB=sislab
# Contraseña que reciben los usuarios importados (en el proyecto 1 no tenían contraseña)
PASSWORD_INICIAL=Ficct2026
# true = el login muestra botones con una cuenta real por rol (útil en la defensa)
APP_DEMO_LOGIN=false

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Pagos por QR: simulada (sin credenciales) | pagofacil
PAGOS_PASARELA=simulada
PAGOS_MINUTOS_QR=15
PAGOFACIL_URL=
PAGOFACIL_TOKEN_SERVICIO=
PAGOFACIL_TOKEN_SECRETO=
PAGOFACIL_COMERCIO=
